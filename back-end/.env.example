# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/trade_db?schema=public"

# JWT
JWT_SECRET="replace_this_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Gemini_AI
GEMINI_API_KEY="your_gemini_api_key_here"

# Live Search Grounding (optional)
# Defaults to enabled. Set to "false" to disable Google Search grounding
# and fall back to standard (non-grounded) AI analysis.
ENABLE_SEARCH_GROUNDING=true