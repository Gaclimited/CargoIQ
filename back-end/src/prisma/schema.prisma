generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now())

    analyses TradeAnalysis[]

    @@map("users")
}

model TradeAnalysis {
    id                 String   @id @default(uuid())
    userId             String
    originCountry      String
    destinationCountry String
    productName        String
    category           String
    value              Float
    weight             Float
    description        String
    aiResponse         Json
    createdAt          DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("trade_analyses")
}
